# 운영 환경 변수 템플릿. 복사해 .env로 만들고 값을 채운다. .env는 Git에 올리지 않는다(.gitignore).
# 값에 $가 들어가면 반드시 작은따옴표로 감싼다(Compose 변수 치환 방지).

# 접속 주소(도메인)와 바인드할 사설 LAN IP — 공개 IP·0.0.0.0 금지
MKMONEY_DOMAIN=money.kangmin.kr
LAN_BIND_IP=192.168.0.2
# 외부 접속용 Tailscale IPv4(`tailscale ip -4`) — 100.64.0.0/10 대역만 허용
TAILNET_BIND_IP=100.104.129.79

# DB 비밀번호: 영문·숫자만(URL에 들어감). 생성 예: make secret
POSTGRES_PASSWORD=change-me-hex-only

# 세션 서명 비밀(32바이트 이상). 생성 예: make secret
MKMONEY_SESSION_SECRET=change-me-long-random

# 로그인 비밀번호의 Argon2id 해시. 생성: make password-hash  (출력 줄을 그대로 붙여 넣기)
MKMONEY_PASSWORD_HASH='$argon2id$v=19$m=65536,t=3,p=4$c3ludGhldGljc2FsdA$c3ludGhldGljaGFzaHZhbHVlZm9yZXhhbXBsZW9ubHk'
